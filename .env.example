# Copy to .env and fill in real values before running docker compose up.
# Never commit .env to version control.

# --- Required ---

# PostgreSQL password (choose something strong, e.g. openssl rand -hex 32)
PG_PASSWORD=change_me_before_production

# JWT signing secret (must be long and random, e.g. openssl rand -hex 32)
JWT_SECRET=change_me_before_production

# Browser-visible origin of this deployment (used for CORS + cookies)
# Use the URL your staff type into their browser, no trailing slash.
# HTTP example  : CORS_ORIGIN=http://192.168.1.100
# HTTPS example : CORS_ORIGIN=https://ward.my-hospital.example
CORS_ORIGIN=http://localhost

# --- Optional (sensible defaults shown) ---

# PostgreSQL database name and user (change only if you need a custom setup)
PG_DATABASE=warddb
PG_USER=wardapp

# Max DB connections in the pool — 20 handles ~50 concurrent users comfortably
PG_POOL_MAX=20

# Port nginx binds on the host machine
HTTP_PORT=80
# HTTPS_PORT=443

# Vite API base — /api works when nginx is the entry point (recommended)
# Only change this if you expose the backend directly without nginx
VITE_API_BASE=/api

# Number of reverse proxy hops between the internet and this server.
# 1 = single nginx in front (default, correct for this docker-compose setup).
# Increase if the client's network adds an additional load balancer upstream.
TRUST_PROXY=1
