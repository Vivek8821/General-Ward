{"nodes": [{"id": "plan_signup_payment_detailed", "label": "Signup & Payment Integration Detailed Plan", "file_type": "document", "source_file": "docs/plans/signup-payment-detailed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_razorpay_per_seat_billing", "label": "Razorpay Per-Seat Subscription Billing", "file_type": "rationale", "source_file": "docs/plans/signup-payment-detailed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One Razorpay Subscription per tenant with quantity = seat count; Razorpay bills plan_amount x quantity as single consolidated org invoice. Quantity updates take effect at next billing cycle (no mid-cycle surprise charges). pricePerSeat cached in Tenants table."}, {"id": "concept_subscription_enforcement", "label": "Subscription Enforcement Middleware", "file_type": "rationale", "source_file": "docs/plans/signup-payment-detailed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allows read-only access for past_due tenants; blocks writes with 402. Uses 503 for feature flags (temporary disable) vs 402 for payment issues. Skipped when RAZORPAY_KEY_ID not set (payment opt-in)."}, {"id": "concept_org_signup_flow", "label": "Organization Signup Flow", "file_type": "rationale", "source_file": "docs/plans/signup-payment-detailed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two flows: org admin creates tenant+user then Razorpay subscription; staff self-registers via cryptographically random 128-bit invite code. Transaction rollback if any step fails."}, {"id": "concept_invite_code_system", "label": "Invitation Code System", "file_type": "rationale", "source_file": "docs/plans/signup-payment-detailed.md", "source_location": null, "source_url": null, "capture