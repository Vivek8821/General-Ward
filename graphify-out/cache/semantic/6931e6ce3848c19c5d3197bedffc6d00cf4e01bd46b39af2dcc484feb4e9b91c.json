{"nodes": [{"id": "plan_launch_monitoring_contingency_detailed", "label": "Launch Monitoring & Contingency Detailed Plan", "file_type": "document", "source_file": "docs/plans/launch-monitoring-contingency-detailed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_metrics_collector", "label": "In-Memory Metrics Collector", "file_type": "rationale", "source_file": "docs/plans/launch-monitoring-contingency-detailed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-memory only (no Redis/external store), metrics reset on restart. Rolling window capped at 60 entries. Acceptable for first launch; persistent metrics require Prometheus/TimescaleDB."}, {"id": "concept_alert_engine", "label": "Alert Engine", "file_type": "rationale", "source_file": "docs/plans/launch-monitoring-contingency-detailed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fires alert rules on setInterval(60s), logs to stdout and Alerts DB table, tracks active alerts to avoid duplicate firing. ALERT_WEBHOOK_URL enables future Slack/PagerDuty integration without code changes."}, {"id": "concept_feature_flags", "label": "Feature Flags / Kill Switches", "file_type": "rationale", "source_file": "docs/plans/launch-monitoring-contingency-detailed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flags stored in FeatureFlags DB table (persists across restarts); in-memory cache with 10s TTL; fail-open on DB read failure to prevent disabling clinical features when DB has issues."}, {"id": "concept_rollback_plan", "label": "Rollback Plan (Git + Feature Flag + DB)", "file_type": "rationale", "source_file": "docs/plans/launch-monitoring-contingency-detailed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four rollback layers: git revert, feature flag toggle, DB restore from backup, full nuclear rollback. Pre-deploy backup script always runs before deploy."}, {"id": "concept_clinical_workflow_milestones", "label": "Clinical Workflow Milestone Tracking", "file_type": "rationale", "source_file": "docs/plans/launch-monitoring-contingency-detailed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces SaaS 'onboarding milestone conversion' with clinical workflow funnel: patient.admitted \u2192 vitals.recorded \u2192 medication.prescribed \u2192 escalation.created \u2192 patient.discharged."}, {"id": "concept_monitoring_dashboard", "label": "Admin Monitoring Dashboard", "file_type": "rationale", "source_file": "docs/plans/launch-monitoring-contingency-detailed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin-only frontend view with Recharts line/bar charts for request rate, latency, error rate, auth health, workflow funnel, active alerts, and kill switches."}, {"id": "concept_global_error_handler", "label": "Global Express Error Handler", "file_type": "rationale", "source_file": "docs/plans/launch-monitoring-contingency-detailed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needed because server.js currently has no (err,req,res,next) handler. Express 5 natively handles async route errors. Never leak stack to client; respond with requestId only."}], "edges": [{"source": "plan_launch_monitoring_contingency_detailed", "target": "runbook_stress_test_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plans/launch-monitoring-contingency-detailed.md", "source_location": "Section 3 step 3", "weight": 1.0}, {"source": "plan_launch_monitoring_contin