# Database dialect: 'sqlite' or 'postgres'
DB_DIALECT=postgres

# PostgreSQL connection
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=warddb
PG_USER=wardapp
PG_PASSWORD=changeme_before_production
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT=30000
PG_POOL_CONNECTION_TIMEOUT=5000

# Existing variables
JWT_SECRET=your_long_random_string_here
NODE_ENV=production
PORT=3001
