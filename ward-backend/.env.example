# Copy this file to .env and fill in real values. Never commit .env.
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or:
#   openssl rand -hex 32

# ── Required ─────────────────────────────────────────────────────────────────

# JWT signing secret — long random string, never reuse across environments
JWT_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────

NODE_ENV=development        # development | staging | production
PORT=3001                   # port the Express server listens on

# ── Database ─────────────────────────────────────────────────────────────────

# Dialect: 'sqlite' (default for local dev) or 'postgres'
DB_DIALECT=sqlite

# SQLite — path to the database file (relative to ward-backend/)
SQLITE_DB_PATH=./ward.db

# PostgreSQL — set all of these when DB_DIALECT=postgres
# Full connection string (alternative to individual fields below)
DATABASE_URL=
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=warddb
PG_USER=wardapp
PG_PASSWORD=
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT=30000      # ms before idle connection is released
PG_POOL_CONNECTION_TIMEOUT=5000 # ms before giving up on a new connection

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed browser origins.
# Omit in development for a permissive default.
# Required in production — server will refuse to start without it.
# Example: CORS_ORIGIN=http://localhost:5173,https://ward.my-hospital.example
CORS_ORIGIN=

# ── Cookie security ───────────────────────────────────────────────────────────

# SameSite policy for auth cookies. Default: 'lax'.
# Options: 'lax' (default, same-domain), 'strict' (same-domain, no cross-site nav),
#          'none' (cross-origin deployments — requires secure:true, i.e. NODE_ENV=production).
COOKIE_SAME_SITE=lax

# ── Brute-force lockout ───────────────────────────────────────────────────────

# Window in which failed attempts are counted (ms). Default: 900000 (15 min)
LOGIN_LOCKOUT_WINDOW_MS=

# Failed attempts within the window before an IP is locked out. Default: 5
LOGIN_MAX_FAILED_ATTEMPTS=

# How long the lockout lasts (ms). Default: 900000 (15 min)
LOGIN_LOCKOUT_DURATION_MS=

# ── Audit log ────────────────────────────────────────────────────────────────

# Default retention window for POST /api/admin/audit/purge (days).
# Leave unset to require an explicit olderThanDays value on each call.
AUDIT_RETENTION_DAYS=

# ── Networking / proxy ────────────────────────────────────────────────────────

# Number of reverse-proxy hops between the internet and this process.
# Set to 1 when behind nginx/haproxy so Express trusts X-Forwarded-For for rate limiting.
# Leave unset (or 0) in local dev to prevent IP spoofing.
TRUST_PROXY=

# ── Startup ──────────────────────────────────────────────────────────────────

# 'full' (default) runs DB migrations on startup.
# 'perf' skips migrations — use only for load-testing a pre-migrated database.
STARTUP_MODE=

# ── Email / Password reset ────────────────────────────────────────────────────

# Frontend base URL used to build reset links in emails (no trailing slash).
# Example: http://localhost:5173 in dev, https://ward.my-hospital.example in prod.
APP_BASE_URL=http://localhost:5173

# SMTP settings for transactional email (password reset).
# Leave all SMTP_* unset in development — the reset link will be printed to stdout instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true if port 465 (SMTPS), false for STARTTLS
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                 # e.g. "General Ward <noreply@my-hospital.example>"
