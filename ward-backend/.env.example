# Copy to .env and adjust. Never commit real secrets.

# Required in ALL environments (server will not start without it)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

NODE_ENV=development
PORT=3001

# Postgres connection string (enables Postgres health checks).
# If unset, the app continues using SQLite.
# Example:
# DATABASE_URL=postgres://user:pass@localhost:5432/ward
DATABASE_URL=

# Allowed browser origins for CORS (comma-separated). In development, omit for permissive default.
# In production (NODE_ENV=production), this MUST be set or the server will not start.
# Example: CORS_ORIGIN=http://localhost:5173  OR  https://ward.my-hospital.example
# CORS_ORIGIN=

# Frontend (ward-frontend/) uses VITE_API_BASE — see ward-frontend/.env.example

# Trust reverse proxy for IP detection (enables X-Forwarded-For). Only set when behind nginx/ELB/haproxy.
# Leaving this unset (default 0) prevents IP spoofing of rate limits.
# TRUST_PROXY=1

# Optional: default retention window for POST /api/admin/audit/purge when olderThanDays is omitted.
# Use 0 or leave unset to avoid implying a default in some environments.
# AUDIT_RETENTION_DAYS=365
