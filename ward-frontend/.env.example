# Copy this file to .env.local (for local dev) or .env (for deployments).
# Never commit files that contain real values.

# ── Required ─────────────────────────────────────────────────────────────────

# Base URL of the ward-backend API server.
# The client appends /api automatically unless the value already ends with /api.
#
# Local dev pointing to a locally-running backend:
#   VITE_API_BASE=http://localhost:3001
#
# Docker-compose / nginx deployment (nginx proxies /api → backend):
#   VITE_API_BASE=/api
#
# Remote / staging deployment:
#   VITE_API_BASE=https://api.my-hospital.example
VITE_API_BASE=http://localhost:3001
