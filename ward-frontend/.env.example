# Copy to `.env` or `.env.local` in this directory (never commit real secrets).
# API origin used by the SPA (see src/utils/api.js). If unset, defaults to http://localhost:3001
# and the client will call http://localhost:3001/api.
#
# Examples:
# VITE_API_BASE=http://localhost:3001
# VITE_API_BASE=https://api.my-hospital.example
# If the value already ends with /api, it is used as the full API prefix (no extra /api appended).
# VITE_API_BASE=http://localhost:3001/api

# VITE_API_BASE=
